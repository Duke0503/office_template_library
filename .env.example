# Copy to .env. Every value here works for a local run; change the secrets for anything shared.

# Port the app listens on (http://localhost:3000)
PORT=3000
LOG_LEVEL=info

# Signs the short-lived file links handed to Document Server
APP_SECRET=change-me-app-secret-0123456789
# Shared with Document Server (its JWT_SECRET); signs editor configs and callbacks
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-secret-0123456789

# Where the browser loads the editor from
PUBLIC_DOCSERVER_URL=http://localhost:8080

# --- Only for `npm run dev` outside Docker (compose sets these itself) ---
# How this app reaches Document Server, and how Document Server reaches this app
DOCSERVER_INTERNAL_URL=http://localhost:8080
APP_INTERNAL_URL=http://host.docker.internal:3000
