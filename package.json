{
  "name": "office-template-library",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/api",
    "test": "npm run test --workspace packages/shared --workspace apps/api --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "templates:generate": "tsx scripts/generate-templates.ts",
    "templates:render": "tsx scripts/render-previews.ts",
    "templates:import": "npm run import --workspace apps/api",
    "test:e2e": "npm run test --workspace e2e"
  },
  "devDependencies": {
    "@types/adm-zip": "0.6.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "adm-zip": "0.6.1",
    "concurrently": "10.0.6",
    "docx": "9.15.0",
    "jsonwebtoken": "9.0.3",
    "pptxgenjs": "4.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
